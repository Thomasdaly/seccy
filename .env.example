# Generate secrets with: openssl rand -hex 32

# --- 2060 (services) ---------------------------------------------------------
# Tailscale IP of this box; compose binds every port to it (tailscale ip -4)
TAILNET_IP=

# LiteLLM refuses to start without it; the orchestrator uses the same value
LITELLM_MASTER_KEY=sk-

# Hosted model keys — leave blank to run local-only
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

POSTGRES_PASSWORD=

# Langfuse v2 server secrets
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=

# Langfuse project keys — Langfuse creates the project with these at startup,
# LiteLLM logs every call with them. Format: pk-lf-<hex> / sk-lf-<hex>
LANGFUSE_PUBLIC_KEY=pk-lf-
LANGFUSE_SECRET_KEY=sk-lf-
LANGFUSE_HOST=http://langfuse:3000
# Web UI login (http://<TAILNET_IP>:3000); signup is disabled
LANGFUSE_INIT_USER_EMAIL=admin@harness.local
LANGFUSE_INIT_USER_PASSWORD=

# --- M1 (orchestrator) -------------------------------------------------------
LITELLM_BASE_URL=http://<2060-tailscale-ip>:4000
# LITELLM_MASTER_KEY above, same value as on the 2060
