# Hosted model keys — leave blank to run local-only
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Postgres
POSTGRES_PASSWORD=change-me

# Langfuse (only if you enable the callback)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Orchestrator (M1) — LiteLLM router on the 2060 over Tailscale
LITELLM_BASE_URL=http://<2060-tailscale-ip>:4000
